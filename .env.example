# Both keys are required (a free-tier Gemini key from Google AI Studio works). The app does not use mock data: without keys, /api/plan returns 503.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high
GEMINI_THINKING=low
# Models tried in order when GEMINI_MODEL is overloaded (5xx) or unavailable (404). Comma-separated.
# Leave empty for the default (gemini-3.5-flash,gemini-3-flash-preview); "none" disables fallback.
GEMINI_FALLBACK_MODELS=

# Recommended: free NVIDIA key (build.nvidia.com). When set, NVIDIA Nemotron is the primary model and Gemini
# is the fallback (a run whose first NVIDIA call fails moves to Gemini). LLM_PROVIDER=gemini flips the order.
NVIDIA_API_KEY=
# Leave empty for the default (nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-super-120b-a12b).
NVIDIA_MODELS=

PORT=3000
# Private server-side data: Qloo response cache, saved plans, session kits, family invites. Never commit it.
CACHE_DIR=.cache

# Public demo limits: plans per IP per hour, and plans per UTC day across all users.
PUBLIC_RATE_LIMIT_PER_HOUR=20
DAILY_PLAN_CAP=200
