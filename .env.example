# Both keys are required (a free-tier Gemini key from Google AI Studio works). The app does not use mock data: without keys, /api/plan returns 503.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# minimal | low | medium | high
GEMINI_THINKING=low

PORT=3000
# Private server-side cache for Qloo responses and finished plans. Never commit it.
CACHE_DIR=.cache
